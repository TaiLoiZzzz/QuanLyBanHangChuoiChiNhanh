{
  "name": "quan-ly-ban-hang-chuoi-chi-nhanh",
  "version": "1.0.0",
  "description": "He thong Quan ly Ban hang & Chuoi Ton kho Da Chi nhanh - DBMS HCMUTE",
  "scripts": {
    "db:up": "docker compose --env-file backend/.env up -d --wait",
    "db:down": "docker compose down",
    "backend:start": "node backend/src/server.js",
    "frontend:dev": "npm run --prefix frontend dev",
    "frontend:build": "npm run --prefix frontend build",
    "test": "node --test backend/test/unit.test.cjs",
    "test:full": "node backend/test/regression.cjs",
    "test:business": "node backend/test/regression.cjs",
    "db:init": "node scripts/database.cjs init",
    "db:migrate": "node scripts/database.cjs migrate",
    "db:recovery": "node scripts/database.cjs recovery",
    "sql:build": "node scripts/build-sql.cjs",
    "sql:check": "node scripts/build-sql.cjs --check",
    "test:integration": "node backend/test/regression.cjs",
    "test:system": "node backend/test/regression.cjs",
    "db:backup": "node scripts/database.cjs backup",
    "db:restore": "node scripts/database.cjs restore"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
